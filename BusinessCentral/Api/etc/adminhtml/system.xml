<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="businesscentral" translate="label" sortOrder="10">
            <label>Business Central</label>
        </tab>
        <section id="businesscentral_api" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>API Configuration</label>
            <tab>businesscentral</tab>
            <resource>BusinessCentral_Api::config</resource>
            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General Settings</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="api_url" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>API URL</label>
                    <validate>required-entry</validate>
                </field>
                <field id="tenant_id" translate="label" type="text" sortOrder="25" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Tenant ID</label>
                    <validate>required-entry</validate>
                </field>
                <field id="client_id" translate="label" type="text" sortOrder="26" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Client ID</label>
                    <validate>required-entry</validate>
                </field>
                <field id="client_secret" translate="label" type="obscure" sortOrder="27" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Client Secret</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <validate>required-entry</validate>
                </field>
                <field id="scope" translate="label" type="text" sortOrder="28" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>OAuth2 Scope</label>
                    <comment>e.g. https://api.businesscentral.dynamics.com/.default</comment>
                </field>
                <field id="start_date" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Default Start Date for Sync</label>
                </field>
            </group>
        </section>
    </system>
</config>
